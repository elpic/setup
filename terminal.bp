# Terminal emulator

gpg_key https://apt.fury.io/wez/gpg.key keyring: wezterm-fury deb-url: https://apt.fury.io/wez/ id: wezterm-gpg on: [linux]

install wezterm after: wezterm-gpg on: [linux, mac]

# Shell

install zsh on: [linux, mac]

# Developer Tools 

install git on: [linux, mac]

# Aditional tools for the terminal

# oh-my-zsh zsh improvements

clone https://github.com/ohmyzsh/ohmyzsh.git to: ~/.oh-my-zsh/ id: oh-my-zsh on: [linux, mac]

download https://git.io/antigen to: ~/.oh-my-zsh/antigen.zsh overwrite: false after: oh-my-zsh on: [linux, mac]

# Install sesh

install zoxide on: [linux, mac] 

homebrew sesh after: zoxide on: [linux, mac]

# Nushell: modern shell with structured data, tried alongside zsh
homebrew nushell id: homebrew-nushell

# Carapace: completion bridge so nushell gets zsh/bash/fish completions
homebrew carapace

# Starship: cross-shell prompt used by nushell (zsh keeps p10k)
homebrew starship

# Register nushell's binary path in /etc/shells so chsh accepts it.
# `which nu` resolves cross-platform (/opt/homebrew/bin/nu on macOS,
# /home/linuxbrew/.linuxbrew/bin/nu on Linux). Idempotent via `unless:`.
run 'grep -qxF "$(which nu)" /etc/shells || echo "$(which nu)" | tee -a /etc/shells > /dev/null' unless: 'grep -qxF "$(which nu)" /etc/shells' sudo: true id: register-nu-shells after: homebrew-nushell on: [mac, linux]

# Set nushell as the default login shell on both platforms
shell nu after: register-nu-shells on: [mac, linux]
